# Copy to .env.local and fill in. Never commit .env.local.
# Supabase values are needed from M4 onwards.

# Public — safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never import into client components.
SUPABASE_SERVICE_ROLE_KEY=
